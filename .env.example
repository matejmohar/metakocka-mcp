# Metakocka API credentials.
# How to get them: https://metakocka.freshdesk.com/en/support/solutions/articles/3000106126
METAKOCKA_COMPANY_ID=
METAKOCKA_SECRET_KEY=

# --- Connection (optional) ---
# Another Metakocka installation: a URL, host name or IP (https is assumed, /rest/eshop/v1 is added when no path is given)
# METAKOCKA_BASE_URL=https://main.metakocka.si/rest/eshop/v1
# CA certificate (PEM) for an installation with a company or self-signed certificate
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem
# Request timeout in milliseconds, or METAKOCKA_TIMEOUT_SECONDS (used when METAKOCKA_TIMEOUT_MS is not set)
# METAKOCKA_TIMEOUT_MS=30000
# METAKOCKA_TIMEOUT_SECONDS=30
# Requests at once (all kinds), searches at once (never more than the former), and how long a request waits for a free slot
# METAKOCKA_MAX_CONCURRENT=2
# METAKOCKA_MAX_CONCURRENT_SEARCH=1
# METAKOCKA_QUEUE_TIMEOUT_SECONDS=300
# How long warehouses and partner lookups are reused; 0 turns caching off
# METAKOCKA_CACHE_SECONDS=300

# --- Files and identity (optional) ---
# Where get_document_pdf, get_proof_of_delivery and accounting_export save files (default ~/Downloads/Metakocka)
# METAKOCKA_PDF_DIR=/path/to/folder
# E-mail of a Metakocka user, sent by check_blacklist and draft_complaint when Metakocka asks who is making the call
# METAKOCKA_USER_EMAIL=

# --- Creating documents (optional, off by default) ---
# Comma-separated areas Claude may write to. Allowed values:
#   offers             create offers
#   orders             create sales orders and invoices from them; change orders
#   invoices           create invoices and prepayment invoices; change an invoice's status
#   credit_notes       create credit notes to invoices, enter suppliers' credit notes
#   purchase_invoices  enter received invoices
#   purchase_orders    create purchase orders
#   warehouse          packing lists, goods received notes, delivery/receiving orders, transfers, work orders
#   partners           add missing partners and change existing ones
#   products           add missing products and change existing ones
#   payments           record payments on invoices, offers and orders
#   shipping           print delivery labels, mark orders shipped, group expeditions
#   complaints         complaints, returns and replacements, and their status
#   messages           send SMS, Viber, WhatsApp and e-mail to customers
# Details: docs/writing.md
# METAKOCKA_WRITE=partners,products,orders,invoices
#
# Instead of METAKOCKA_WRITE, each area can be turned on separately with METAKOCKA_WRITE_<AREA>=true
# (this is what the Claude Desktop extension's "Allow ..." checkboxes set). Both can be combined.
# METAKOCKA_WRITE_OFFERS=true
# METAKOCKA_WRITE_ORDERS=true
# METAKOCKA_WRITE_INVOICES=true
# METAKOCKA_WRITE_CREDIT_NOTES=true
# METAKOCKA_WRITE_PURCHASE_INVOICES=true
# METAKOCKA_WRITE_PURCHASE_ORDERS=true
# METAKOCKA_WRITE_WAREHOUSE=true
# METAKOCKA_WRITE_PARTNERS=true
# METAKOCKA_WRITE_PRODUCTS=true
# METAKOCKA_WRITE_PAYMENTS=true
# METAKOCKA_WRITE_SHIPPING=true
# METAKOCKA_WRITE_COMPLAINTS=true
# METAKOCKA_WRITE_MESSAGES=true
#
# How each document is confirmed before it is saved:
#   client (default)  a confirmation prompt, or your approval of the save in your client
#   elicitation       confirmation prompts only; clients without them can't save
#   never             no confirmation
# METAKOCKA_WRITE_CONFIRM=client
# How long to wait for Metakocka to save a document
# METAKOCKA_WRITE_TIMEOUT_SECONDS=120
# Audit log of every write, JSON lines (default ~/.metakocka-mcp/writes.jsonl)
# METAKOCKA_WRITE_LOG=/path/to/writes.jsonl

# --- HTTP mode (metakocka-mcp --http), see docs/http-server.md ---
# METAKOCKA_HTTP_PORT=3000
# 127.0.0.1 = this computer only; 0.0.0.0 accepts connections from other computers
# METAKOCKA_HTTP_HOST=127.0.0.1
# Require "Authorization: Bearer <token>" on every request; required when METAKOCKA_WRITE is set
# METAKOCKA_HTTP_TOKEN=
# Comma-separated host names clients connect with
# METAKOCKA_HTTP_ALLOWED_HOSTS=
